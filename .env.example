DATABASE_URL=sqlite:///./quant_agent_lab.db
ORCHESTRATOR=simple
DATA_PROVIDER=mock

# --- 通达信 MCP（主数据源，免费） -----------------------------------------
# 自建示例: pip install tdx-mcp && tdx-mcp --port 8100
TDX_MCP_ENDPOINT=
TDX_MCP_TOKEN=

# --- Wind MCP（本机 WindPy + 开源 wind-mcp，复用终端额度） -----------------
# 必须跑在装有 Wind 终端并已登录的 Windows 上
WIND_MCP_ENDPOINT=
WIND_MCP_TOKEN=

# --- LLM（可选；不配置时用确定性规则，无需任何 key） -----------------------
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_CHEAP=deepseek-v4-flash
LLM_MODEL_STRONG=deepseek-v4-flash

# --- 护栏 ------------------------------------------------------------------
MAX_TOKENS_PER_RUN=120000
MAX_UNIVERSE=50
DEMO_MODE=true
API_CORS_ORIGINS=*
LOG_JSON=0
LOG_LEVEL=INFO
